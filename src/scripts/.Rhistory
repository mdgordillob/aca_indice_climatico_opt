if (nrow(climate_data) == 0)
stop("There is no available information for the requested dates")
return(climate_data)
}
# ── Setup ─────────────────────────────────────────────────────────────────────
output_dir <- "../../data/raw/ideam/"
dir.create(output_dir, showWarnings = FALSE, recursive = TRUE)
message("Fetching stations in ROI...")
all_stations <- stations_in_roi(geometry = roi)
cw_stations <- all_stations %>%
filter(
as.Date(fecha_suspension) > as.Date("1960-01-01") | estado == "Activa",
categoria %in% c("Climática Principal", "Climática Ordinaria")
)
message(sprintf("Found %d climatic stations in Colombia", nrow(cw_stations)))
# ── Main download loop ────────────────────────────────────────────────────────
summary_rows <- list()
for (period in TEST_PERIODS) {
for (tag in TAGS) {
label    <- sprintf("%s_%s", tag, period$label)
out_path <- file.path(output_dir, sprintf("ideam_%s.rds", label))
if (file.exists(out_path)) {
message(sprintf("  ✓ Cached : %s", basename(out_path)))
next
}
message(sprintf("\n  Downloading %s | %s → %s", tag, period$start, period$end))
result <- tryCatch(
download_climate_stations_fixed(
stations   = cw_stations,
start_date = period$start,
end_date   = period$end,
tag        = tag
),
error = function(e) {
message(sprintf("    ✗ Failed: %s", e$message))
NULL
}
)
if (!is.null(result)) {
saveRDS(result, out_path)
message(sprintf("    ✓ Saved  : %s  [%d rows, %d stations]",
basename(out_path),
nrow(result),
length(unique(result$station))))
summary_rows[[length(summary_rows) + 1L]] <- data.frame(
tag        = tag,
period     = period$label,
n_rows     = nrow(result),
n_stations = length(unique(result$station)),
stringsAsFactors = FALSE
)
}
}
}
library(dplyr)
library(sf)
library(progress)
library(lubridate)
# ── Your fixed function must be defined here ────────────────────────────────
# Paste your download_climate_stations_fixed(...) here if not already loaded
# (the version with climate_data[[length(climate_data) + 1L]] <- station_obs)
# ── Colombia bounding box polygon ───────────────────────────────────────────
lat <- c(13.4, 13.4, -4.23, -4.23, 13.4)
lon <- c(-81.73, -66.87, -66.87, -81.73, -81.73)
polygon <- st_polygon(x = list(cbind(lon, lat))) %>% st_sfc()
colombia_roi <- st_as_sf(polygon)
# Get all stations in Colombia
message("Fetching all stations in Colombia...")
all_stations <- stations_in_roi(geometry = colombia_roi)
# Filter to active/recent Climática stations (your original logic)
cw_stations_country <- all_stations %>%
filter(
as.Date(fecha_suspension) > as.Date("2013-01-01") | estado == "Activa",
categoria %in% c("Climática Principal", "Climática Ordinaria")
)
message("Number of stations after filter: ", nrow(cw_stations_country))
# ── Time chunks (5-year periods) ────────────────────────────────────────────
start_year <- 1980
end_year   <- 2024
chunk_size <- 5
chunks <- data.frame(
start = seq(start_year, end_year, by = chunk_size),
end   = pmin(seq(start_year, end_year, by = chunk_size) + chunk_size - 1, end_year)
)
# Output file (append mode)
output_csv <- "../../data/processed/colombia_tssm_con_all.csv"
# ── Progress bar for chunks ─────────────────────────────────────────────────
pb <- progress_bar$new(
format = "[:bar] :current/:total chunks  | :percent  | ETA: :eta  | :rate chunks/s",
total = nrow(chunks),
clear = FALSE,
width = 80
)
# ── Download loop with progress & append ────────────────────────────────────
for (i in seq_len(nrow(chunks))) {
chunk_start <- chunks$start[i]
chunk_end   <- chunks$end[i]
start_date <- paste0(chunk_start, "-01-01")
end_date   <- paste0(chunk_end,   "-12-31")
pb$tick(tokens = list(what = paste(chunk_start, "–", chunk_end)))
message("→ Downloading chunk: ", start_date, " to ", end_date, " ...")
tryCatch({
chunk_data <- download_climate_stations_fixed(
stations   = cw_stations_country,
start_date = start_date,
end_date   = end_date,
tag        = "TSSM_CON"
)
if (nrow(chunk_data) > 0) {
# Optional: add chunk identifier if needed
chunk_data$chunk <- paste(chunk_start, chunk_end, sep = "-")
# Append to CSV (header only on first write)
write.table(
chunk_data,
file      = output_csv,
append    = file.exists(output_csv),
sep       = ",",
row.names = FALSE,
col.names = !file.exists(output_csv)
)
message("  ✓ Saved ", nrow(chunk_data), " rows for this chunk")
} else {
message("  No data in this chunk")
}
}, error = function(e) {
message("  ✗ Error in chunk ", start_date, "–", end_date, ": ", e$message)
# Continue to next chunk
})
# Small pause to avoid overwhelming server (optional)
Sys.sleep(2)
}
library(ColOpenData)
library(dplyr)
library(sf)
library(cli)
download_climate_stations_fixed <- function(stations, start_date, end_date, tag) {
checkmate::assert_data_frame(stations)
checkmate::assert_subset(c("codigo", "longitud", "latitud"), names(stations))
args          <- ColOpenData:::check_climate_args(start_date, end_date, tag)
path_data     <- ColOpenData:::retrieve_climate_path()
path_stations <- paste0(args[["tag"]], "@", stations[["codigo"]], ".data")
if (nrow(stations) > 5) {
existing_data <- ColOpenData:::retrieve_table(
ColOpenData:::retrieve_support_path("IDEAM_AVAILABLE_INFO")
)
keep          <- which(path_stations %in% existing_data[["file"]])
stations      <- stations[keep, ]
path_stations <- path_stations[keep]
}
n_total      <- length(path_stations)
climate_data <- list()
n_found      <- 0L
n_empty      <- 0L
t_start      <- proc.time()[["elapsed"]]
cli::cli_progress_bar(
name   = sprintf("{tag} | {period_label}"),
total  = n_total,
format = paste0(
"{cli::pb_spin} {tag} [{cli::pb_bar}] {cli::pb_current}/{cli::pb_total} stations ",
"| found: {n_found} empty: {n_empty} ",
"| {cli::pb_rate} | ETA {cli::pb_eta}"
),
format_done = paste0(
"{col_green(symbol$tick)} {tag} [{period_label}] done in {cli::pb_elapsed} ",
"| {n_found}/{n_total} stations returned data"
),
.envir = environment(),
clear  = FALSE
)
for (i in seq_along(path_stations)) {
downloaded_station <- ColOpenData:::retrieve_climate(
file.path(path_data, path_stations[i])
)
if (!rlang::is_empty(downloaded_station)) {
station_filtered <- downloaded_station %>%
dplyr::filter(
.data[["date"]] >= args[["start_date"]],
.data[["date"]] <= args[["end_date"]] + 1
)
n_obs <- nrow(station_filtered)
if (n_obs > 0) {
n_found <- n_found + 1L
climate_data[[n_found]] <- data.frame(
station   = rep(stations[["codigo"]][i],   n_obs),
longitude = rep(stations[["longitud"]][i], n_obs),
latitude  = rep(stations[["latitud"]][i],  n_obs),
date      = format(station_filtered[["date"]], "%Y-%m-%d"),
hour      = format(station_filtered[["date"]], "%H:%M:%S"),
tag       = rep(args[["tag"]], n_obs),
value     = station_filtered[["value"]],
stringsAsFactors = FALSE
)
} else {
n_empty <- n_empty + 1L
}
} else {
n_empty <- n_empty + 1L
}
cli::cli_progress_update(.envir = environment())
}
cli::cli_progress_done(.envir = environment())
climate_data <- dplyr::bind_rows(climate_data)
if (nrow(climate_data) == 0)
stop("There is no available information for the requested dates")
return(climate_data)
}
# ── ROI: all Colombia ─────────────────────────────────────────────────────────
lat <- c(13.0, 13.0, -4.6, -4.6, 13.0)
lon <- c(-83.0, -66.1, -66.1, -83.0, -83.0)
polygon <- st_polygon(x = list(cbind(lon, lat))) %>% st_sfc()
roi     <- st_as_sf(polygon)
TAGS <- c("TSSM_CON", "PTPM_CON", "VVAG_CON", "HRHG_CON")
TEST_PERIODS <- list(
list(start = "2010-01-01", end = "2010-12-31", label = "2010"),
list(start = "2020-01-01", end = "2024-12-31", label = "2020-2024")
)
output_dir <- "../../data/raw/ideam/"
dir.create(output_dir, showWarnings = FALSE, recursive = TRUE)
cli::cli_h1("Fetching Colombia climatic stations")
all_stations <- stations_in_roi(geometry = roi)
cw_stations  <- all_stations %>%
filter(
as.Date(fecha_suspension) > as.Date("1960-01-01") | estado == "Activa",
categoria %in% c("Climática Principal", "Climática Ordinaria")
)
cli::cli_alert_success("Found {nrow(cw_stations)} climatic stations")
# ── Outer loop ────────────────────────────────────────────────────────────────
summary_rows <- list()
for (period in TEST_PERIODS) {
cli::cli_h2("Period: {period$label} ({period$start} \u2192 {period$end})")
for (tag in TAGS) {
# expose to progress bar format string
period_label <- period$label
label    <- sprintf("%s_%s", tag, period$label)
out_path <- file.path(output_dir, sprintf("ideam_%s.rds", label))
if (file.exists(out_path)) {
cli::cli_alert_info("Cached: {basename(out_path)}")
next
}
result <- tryCatch(
download_climate_stations_fixed(
stations   = cw_stations,
start_date = period$start,
end_date   = period$end,
tag        = tag
),
error = function(e) {
cli::cli_alert_danger("{tag} failed: {e$message}")
NULL
}
)
if (!is.null(result)) {
saveRDS(result, out_path)
cli::cli_alert_success(
"Saved {basename(out_path)} [{nrow(result)} rows, {length(unique(result$station))} stations]"
)
summary_rows[[length(summary_rows) + 1L]] <- data.frame(
tag        = tag,
period     = period$label,
n_rows     = nrow(result),
n_stations = length(unique(result$station)),
stringsAsFactors = FALSE
)
}
}
}
# ── Summary ───────────────────────────────────────────────────────────────────
if (length(summary_rows) > 0) {
summary_df <- dplyr::bind_rows(summary_rows)
cli::cli_h1("Data availability summary")
print(summary_df)
saveRDS(summary_df, file.path(output_dir, "ideam_test_summary.rds"))
}
library(dplyr)
library(sf)
library(terra)
library(ggplot2)
library(tidyr)
library(purrr)
library(cli)
# ── Paths ─────────────────────────────────────────────────────────────────────
IDEAM_DIR  <- "../../data/raw/ideam/"
ERA5_DIR   <- "../../data/raw/era5_land/"
OUTPUT_DIR <- "../../data/processed/era5_ideam_comparison/"
dir.create(OUTPUT_DIR, showWarnings = FALSE, recursive = TRUE)
# ── Variable mapping IDEAM tag → ERA5 slug ────────────────────────────────────
VAR_MAP <- list(
TSSM_CON = list(slug = "tmp",  era5_scale = 1,    era5_offset = -273.15, label = "Temperature (°C)"),
PTPM_CON = list(slug = "rain", era5_scale = 1000, era5_offset = 0,       label = "Precipitation (mm)")
)
PERIODS <- list(
list(label = "2010",      years = 2010),
list(label = "2020-2024", years = 2020:2024)
)
# ── Helpers ───────────────────────────────────────────────────────────────────
# Aggregate IDEAM to monthly means
ideam_monthly <- function(df) {
df %>%
mutate(date = as.Date(date), month = format(date, "%Y-%m")) %>%
group_by(station, longitude, latitude, tag, month) %>%
summarise(obs = mean(value, na.rm = TRUE), .groups = "drop")
}
# Load and aggregate ERA5 grib for given years + variable to monthly means
era5_monthly <- function(slug, years, scale, offset) {
cli::cli_alert_info("Loading ERA5 {slug} for years {paste(years, collapse=', ')}")
rasters <- map(years, function(yr) {
path <- file.path(ERA5_DIR, sprintf("era5land_%s_%d.grib", slug, yr))
if (!file.exists(path)) {
cli::cli_alert_warning("Missing: {basename(path)}, skipping")
return(NULL)
}
r <- terra::rast(path)
# Apply scale/offset
r <- r * scale + offset
# Attach month labels from layer times
times <- terra::time(r)
months <- format(times, "%Y-%m")
# Monthly mean: one layer per month
months_unique <- unique(months)
monthly <- map(months_unique, function(m) {
idx <- which(months == m)
layer <- terra::mean(terra::subset(r, idx), na.rm = TRUE)
names(layer) <- m
layer
})
terra::rast(monthly)
}) %>% compact()
if (length(rasters) == 0) return(NULL)
terra::rast(rasters)
}
# Extract ERA5 at station points: nearest neighbour + bilinear, return both
extract_era5_at_stations <- function(era5_rast, stations_sf) {
nn  <- terra::extract(era5_rast, stations_sf, method = "simple",   bind = FALSE)
bil <- terra::extract(era5_rast, stations_sf, method = "bilinear", bind = FALSE)
months <- names(era5_rast)
nn_long <- nn %>%
as.data.frame() %>%
mutate(station = stations_sf$station) %>%
pivot_longer(-c(ID, station), names_to = "month", values_to = "era5_nn") %>%
select(station, month, era5_nn)
bil_long <- bil %>%
as.data.frame() %>%
mutate(station = stations_sf$station) %>%
pivot_longer(-c(ID, station), names_to = "month", values_to = "era5_bil") %>%
select(station, month, era5_bil)
left_join(nn_long, bil_long, by = c("station", "month"))
}
# ── Stats ─────────────────────────────────────────────────────────────────────
compute_stats <- function(df, era5_col) {
df %>%
group_by(station, longitude, latitude, tag, period) %>%
summarise(
n      = sum(!is.na(obs) & !is.na(.data[[era5_col]])),
bias   = mean(.data[[era5_col]] - obs, na.rm = TRUE),
rmse   = sqrt(mean((.data[[era5_col]] - obs)^2, na.rm = TRUE)),
r2     = cor(obs, .data[[era5_col]], use = "complete.obs")^2,
.groups = "drop"
)
}
# ── Main loop ─────────────────────────────────────────────────────────────────
all_comparison <- list()
for (tag in names(VAR_MAP)) {
meta <- VAR_MAP[[tag]]
cli::cli_h1("{tag}")
for (period in PERIODS) {
cli::cli_h2("Period: {period$label}")
# ── Load IDEAM ────────────────────────────────────────────────────────────
ideam_path <- file.path(IDEAM_DIR, sprintf("ideam_%s_%s.rds", tag, period$label))
if (!file.exists(ideam_path)) {
cli::cli_alert_warning("Missing IDEAM file: {basename(ideam_path)}, skipping")
next
}
ideam_raw <- readRDS(ideam_path)
ideam_mon <- ideam_monthly(ideam_raw)
cli::cli_alert_success("IDEAM: {nrow(ideam_mon)} station-months from {length(unique(ideam_mon$station))} stations")
# ── Load ERA5 ─────────────────────────────────────────────────────────────
era5_rast <- era5_monthly(meta$slug, period$years, meta$era5_scale, meta$era5_offset)
if (is.null(era5_rast)) {
cli::cli_alert_danger("No ERA5 data for {tag} {period$label}, skipping")
next
}
# ── Build stations sf ─────────────────────────────────────────────────────
stations_sf <- ideam_mon %>%
distinct(station, longitude, latitude) %>%
st_as_sf(coords = c("longitude", "latitude"), crs = 4326) %>%
terra::vect()
# ── Extract ERA5 at stations ──────────────────────────────────────────────
cli::cli_alert_info("Extracting ERA5 at {nrow(stations_sf)} station locations")
era5_extracted <- extract_era5_at_stations(era5_rast, stations_sf)
# ── Join IDEAM + ERA5 ─────────────────────────────────────────────────────
comparison <- ideam_mon %>%
left_join(era5_extracted, by = c("station", "month")) %>%
mutate(period = period$label, tag = tag)
all_comparison[[length(all_comparison) + 1L]] <- comparison
cli::cli_alert_success("Joined: {nrow(comparison)} rows")
}
}
