}
extract_era5_at_stations <- function(era5_rast, stations_vect) {
nn  <- terra::extract(era5_rast, stations_vect, method = "simple")
bil <- terra::extract(era5_rast, stations_vect, method = "bilinear")
nn_long <- nn %>%
as.data.frame() %>%
mutate(station = stations_vect$station) %>%
pivot_longer(-c(ID, station), names_to = "month", values_to = "era5_nn") %>%
select(station, month, era5_nn)
bil_long <- bil %>%
