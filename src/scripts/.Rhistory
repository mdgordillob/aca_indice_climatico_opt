PTPM_CON = list(slug = "rain", era5_scale = 1000, era5_offset = 0,       label = "Precipitation (mm)")
)
PERIODS <- list(
list(label = "2010",      years = 2010),
list(label = "2020-2024", years = 2020:2024)
